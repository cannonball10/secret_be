# Secret Hitler web client environment.
#
# Copy this file to .env.local (Vite auto-loads it) and override any
# values you need:
#
#     cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle,
# which is why every public flag uses that prefix.

# Backend origin. Leave blank in dev — the client issues same-origin
# requests and vite.config.ts proxies /api and /healthz to the Go
# server on :8080. Set to an absolute URL only for prod builds or when
# pointing a dev client at a staging backend (requires CORS on the
# server, which is not currently wired up).
VITE_API_URL=
