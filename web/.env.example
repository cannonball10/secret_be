# Secret Hitler web client environment.
#
# Copy this file to .env.local (Vite auto-loads it) and override any
# values you need:
#
#     cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle,
# which is why every public flag uses that prefix.

# Backend origin. During `npm run dev` the vite.config.ts proxy forwards
# /api and /healthz to this address, so leaving it as the default is
# usually fine. Override for pointing a deployed client at a staging
# backend.
VITE_API_URL=http://localhost:8080
