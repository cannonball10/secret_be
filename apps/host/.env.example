# ─── Replicant · host TV app (apps/host) ───────────────────────────
#
# Copy to .env.local and fill in whatever you actually have. Every
# var is optional — omit them all and the host runs in guest mode
# against the local Go backend.

# ─── API target ────────────────────────────────────────────────────
# URL the browser hits for REST + SSE. Leave empty when running the
# Next dev server on localhost (apps/host auto-points to :8080).
# Set in prod to the public API origin.
# NEXT_PUBLIC_API_ORIGIN=https://api.replicant.example.com

# URL the mobile app serves the /join/CODE page from. The lobby uses
# this to build the QR code. In dev Next runs mobile on :3001.
# NEXT_PUBLIC_MOBILE_URL=http://localhost:3001

# ─── Clerk (optional — sign-in CTA on the host) ────────────────────
# When both keys are present the home page shows a SIGN IN CTA and
# REST calls carry the user's Clerk JWT. Without them the host runs
# anonymously — every session is a fresh guest.
#
# Get keys from https://dashboard.clerk.com → API Keys.

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Optional: redirect paths after sign-in / sign-up. Default "/".
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
