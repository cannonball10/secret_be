# Replicant backend environment.
#
# Copy this file to .env and fill in values for your environment:
#
#     cp .env.example .env
#
# The cmd/api binary loads it via godotenv on startup so `go run
# ./cmd/api` picks the values up automatically. Nothing here is
# secret in the file itself — real secrets belong in your shell or
# a secret manager, not committed.

# ─── API server ────────────────────────────────────────────────────

# Port the Gin HTTP server listens on. Default is 8080.
API_PORT=8080

# Gin mode: "debug" | "release" | "test". Default "release".
GIN_MODE=debug

# ─── Demo mode (dev only) ──────────────────────────────────────────
#
# When SIMULATE_ON_CREATE=1, every successful POST /api/v1/games kicks
# off a background goroutine that joins bot players, starts the match,
# and plays it through with random-valid actions. Lets the board device
# watch a full end-to-end game without needing human players.

SIMULATE_ON_CREATE=0
# SIMULATE_PLAYERS=7        # total seats incl. host; clamped to [5,10]
# SIMULATE_STEP_MS=1500     # pause between bot actions
# SIMULATE_START_MS=2000    # pause before the first bot joins (lets the host's SSE attach)
# SIMULATE_SEED=            # uint64 seed; omit for time-based randomness
# SIMULATE_HUMAN_SEATS=0    # seats reserved for real players; bots leave those chairs empty,
#                           # and the simulator waits for the host to press Start on the board
#                           # before playing out bots' turns. Set to 1 and open a second
#                           # browser to join your own simulated game.

# ─── CORS ──────────────────────────────────────────────────────────
#
# Origins the browser may hit the API from. Required because the
# Next.js dev server buffers SSE through its rewrite proxy, so the
# host + mobile apps connect directly to :8080 and CORS must allow them.
#
# Defaults cover the dev ports (:3000 host, :3001 mobile) plus
# wildcard entries for the common tunnel providers so you don't have
# to re-edit this file every time ngrok rolls its ephemeral URL.
# Supported pattern: "https://*.domain.tld" matches any subdomain.
#
# Add your staging/prod origins when you deploy. Use "*" (literal)
# for wide-open dev only — never ship that to prod.

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.ngrok-free.dev,https://*.ngrok-free.app,https://*.trycloudflare.com

# ─── Authentication ────────────────────────────────────────────────
#
# If CLERK_SECRET_KEY is set, the server uses ClerkAuth (verifies real
# JWTs). Otherwise it falls back to NopAuth, which treats any non-empty
# bearer token as the user's ID — perfect for local development and
# integration tests.

# CLERK_SECRET_KEY=sk_test_...
# CLERK_BACKEND_URL=https://api.clerk.com

# ─── Database (DynamoDB) ───────────────────────────────────────────
#
# For local dev, run `docker-compose up -d dynamodb` and point here.
# Then bootstrap the table with `./scripts/create-table.sh`.

DYNAMODB_ENDPOINT=http://localhost:8000
FOUNDATION_DATABASE_TABLE=dev

# AWS credentials: required when talking to real DynamoDB; ignored when
# DYNAMODB_ENDPOINT is set (the local client uses a fake pair).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ─── Cache / Redis (used by the foundation connectors we don't touch
#     in Replicant today, but harmless to leave configured) ──────

REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ─── Logging ───────────────────────────────────────────────────────

# "production" switches utils/logging.go to structured JSON output.
APP_ENV=development

# ─── Optional foundation connectors ────────────────────────────────
#
# The Replicant backend does not currently use these, but the
# upstream foundation package does. Left here for completeness so a
# full DefaultConnectors() bootstrap would have what it needs.

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# QDRANT_HOST=localhost
# QDRANT_PORT=6334

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# LAUNCHDARKLY_SDK_KEY=

# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=key
# LIVEKIT_API_SECRET=secret

# SLACK_API_TOKEN=

# STORAGE_BUCKET=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=          # required for the narrator LLM (Phase 4)
# GOOGLE_AI_API_KEY=

# ─── Narrator (Phase 4) ────────────────────────────────────────────
#
# The Committee narrator uses Claude for script generation and
# ElevenLabs for TTS. BOTH credentials must be set or the server
# disables the POST /host/narrate route (host SPEAK button greys
# out but the rest of the game is unaffected).
#
# Optional override: pick a different Claude model than the default
# (claude-sonnet-4-6).

# NARRATOR_MODEL=claude-sonnet-4-6

# ─── Voice (TTS / STT) ─────────────────────────────────────────────
#
# TTS uses ElevenLabs. Voice ID is required (ElevenLabs has no
# server-side default). Model ID is optional; defaults to
# eleven_turbo_v2_5 — the low-latency model. Other options:
# eleven_multilingual_v2 (higher quality, slower),
# eleven_monolingual_v1 (English only, legacy).

# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# STT uses OpenAI. Single-shot transcription defaults to whisper-1;
# streaming transcription defaults to gpt-4o-mini-transcribe (required
# for the stream=true code path on /v1/audio/transcriptions).

# OPENAI_STT_MODEL=whisper-1
# OPENAI_STT_STREAM_MODEL=gpt-4o-mini-transcribe
